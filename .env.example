# ==========================================
# 敏感凭证配置模板示例 (.env.example)
# 请复制为 .env 并填入您真实的 API 凭据
# ==========================================

# 1. TextIn 试卷/习题去手写笔迹 API 凭证 (https://www.textin.com/document/text_auto_removal)
TEXTIN_APP_ID=your_textin_app_id_here
TEXTIN_SECRET_CODE=your_textin_secret_code_here

# 2. DeepSeek 旗舰深度推理 API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
